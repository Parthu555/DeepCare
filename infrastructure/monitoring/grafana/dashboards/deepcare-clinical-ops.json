      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 6 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(deepcare_ai_inference_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Latency", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(deepcare_ai_inference_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50 (Median) Latency", "refId": "B" },
        { "expr": "sum(rate(deepcare_ai_inference_duration_seconds_sum[5m])) / sum(rate(deepcare_ai_inference_duration_seconds_count[5m]))", "legendFormat": "Avg Latency", "refId": "C" }
      ],
      "title": "DenseNet-121 Inference Duration (Latency Percentiles)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
